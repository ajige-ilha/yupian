#lang reader "../../lang/core-reader.rkt"

(require racket/list "../../main.rkt")

(provide 零 二 三 四 五 六 七 八 九)
(provide 十大耶 十同耶 十小耶 零耶)
(provide 十进 十退)
(provide 十减 十斫)

「 山 『零 : Integer 』 0 」
「 山 『二 : Integer 』 2 」
「 山 『三 : Integer 』 3 」
「 山 『四 : Integer 』 4 」
「 山 『五 : Integer 』 5 」
「 山 『六 : Integer 』 6 」
「 山 『七 : Integer 』 7 」
「 山 『八 : Integer 』 8 」
「 山 『九 : Integer 』 9 」

(: 十大耶 (-> OrdNum OrdNum Boolean))
「 山 「十大耶 『甲 : OrdNum』 『乙 : OrdNum』」 (> 甲 乙) 」
(: 十同耶 (-> Numeric Numeric Boolean))
「 山 「十同耶 『甲 : Numeric』 『乙 : Numeric』」 (= 甲 乙) 」
(: 十小耶 (-> OrdNum OrdNum Boolean))
「 山 「十小耶 『甲 : OrdNum』 『乙 : OrdNum』」 (< 甲 乙) 」
(: 零耶 (-> Numeric Boolean))
「 山 「零耶 『数 : Numeric』」 「十同耶 数 零」」

(: 十进 (-> Numeric Numeric))
「 山 「十进 『数 : Numeric』」 「十 一 数」 」

(: 十减 (-> Numeric Numeric Numeric))
「 山 「十减 『甲 : Numeric 』 『乙 : Numeric 』」 (- 甲 乙) 」

(: 十退 (-> OrdNum OrdNum))
「 山 「十退 『数 : OrdNum』」 (- 数 一) 」

(: 十斫 (-> OrdNum Integer))
「 山 「十斫 『甲 : OrdNum 』 」
    (assert (floor 甲) exact-integer?) 」
