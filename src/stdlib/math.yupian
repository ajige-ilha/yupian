#lang reader "../../lang/core-reader.rkt"

(require racket/list "../../main.rkt")

(provide 零 二 三 四 五 六 七 八 九)
(provide 十大耶 十同耶 十小耶 零耶)
(provide 十进 十退)
(provide 十减)

「 山 零 0 」
「 山 二 2 」
「 山 三 3 」
「 山 四 4 」
「 山 五 5 」
「 山 六 6 」
「 山 七 7 」
「 山 八 8 」
「 山 九 9 」

(: 十大耶 (-> Numeric Numeric Boolean))
「 山 「十大耶 甲 乙」 (> 甲 乙) 」
(: 十同耶 (-> Numeric Numeric Boolean))
「 山 「十同耶 甲 乙」 (= 甲 乙) 」
(: 十小耶 (-> Numeric Numeric Boolean))
「 山 「十小耶 甲 乙」 (= 甲 乙) 」
(: 零耶 (-> Numeric Boolean))
「 山 「零耶 数」「十同耶 数 零」」

(: 十进 (-> Numeric Numeric))
「 山 「十进 数」 「十 一 数」 」

(: 十减 (-> Numeric Numeric Numeric))
「 山 「十减 甲 乙」 (- 甲 乙) 」

(: 十退 (-> Numeric Numeric))
「 山 「十退 数」 「十减 数 一」 」

