#lang reader "../../lang/core-reader.rkt"

(require racket/list "../../main.rkt" "./logical.yupian" "./math.yupian" "./map.yupian")

; Stable keywords, noteworthy in 玉篇字解
(provide 本 末 朷 柆 桝 桐)

; Current version functions, should refactor later
(provide 十木)

;; 本为列表之余部，cdr 也。夫合抱之木生于芥子 卜，开枝散叶。
;; 末为列表之首，car 也。
; Since currenly the thing is not so selfstand, it is a bad idea to use unpack method.
; I wish the language compiles 「山 『本 列』 「田 『『其一 其余』 列』 其余」」
(: 本 (-> (Listof Value) (Listof Value)))
(define (本 val) (cdr val))
(: 末 (-> (Listof Value) Value))
(define (末 val) (car val))

;; 欲以十字求简矣，然当前 compiler 弗解 overload
;; Of course it will be obsolated when I know how to overload
; FIXME Yupian's own type system
(: 十木 (-> (Listof Value) Numeric)) 
「山 「十木 『列 : (Listof Value)』 」
  「戈
    「卜耶 列」
    零
    「十 一 「十木 「本 列」」」」」

;; 列表之初（谓近剥蚀之末）也，从木从刀。
(: 朷 (-> (Listof Value) Value))
「 山 「朷 『列 : (Listof Value)』 」
  「中 『「卜耶 列」 「卜」』 『「卜耶 「本 列」」 「末 列」』 『土 「朷 「本 列」」』」」

;; 寻特定下标之元素也，从木从位省。
(: 柆 (-> (Listof Value) Integer Value ))
「 山 「柆 『列 : (Listof Value) 』 『子 : Integer 』」 
  「中 
    『「卜耶 列」 「卜」』
    『「零耶 子」 「末 列」』 
    『「十小耶 子 零」 「卜」』
    『土 「柆 「本 列」 「十斫 「十退 子」」」 』 」 」

;; 逆转一列表。
;; Jai guru deva om
(: 桝 (-> (Listof Value) (Listof Value)))
「山 「桝 『列 : (Listof Value)』」
  「口 
    (Listof Value) ; Sorry for ugliness but wait for the uniform return-value-type syntax
    ; 何事未解脱？忐忑未卜也
    「否 「卜耶 未济」」
    ; 始于何？
    『『既济 : (Listof Value) 「卜」』 『未济 : (Listof Value) 列』』
    ; 续于何？
    『 「廿 「末 未济」 既济」 「本 未济」 』
    ; 出于何？
    既济 」」

;; 判列表相等
;; CAVEAT 目前唯以共同基数较之。
(: 桐 (-> (Listof Value) (Listof Value) Boolean))
「山 「桐 『甲 : (Listof Value) 』 『乙 : (Listof Value) 』 」
  「筌 「竺 同 甲 乙」」」
