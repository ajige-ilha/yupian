#lang reader "../../lang/core-reader.rkt"

(require racket/list "../../main.rkt" "./math.yupian")

; Stable keywords, noteworthy in 玉篇字解
(provide 本 末 朷 柆)

; Current version functions, should refactor later
(provide 十木)

;; 本为列表之余部，cdr 也。夫合抱之木生于芥子 卜，开枝散叶。
;; 末为列表之首，car 也。
(: 本 (-> (Listof Value) (Listof Value)))
(: 末 (-> (Listof Value) Value))
; Since currenly the thing is not so selfstand, it is a bad idea to use unpack method.
; I wish the language compiles 「山 『本 列』 「田 『『其一 其余』 列』 其余」」
(define 本 cdr) 
(define 末 car)

;; 欲以十字求简矣，然当前 compiler 弗解 overload
;; Of course it will be obsolated when I know how to overload
; FIXME Yupian's own type system
(: 十木 (-> (Listof Value) Numeric))
「山 「十木 列」
  「戈
    「卜耶 列」
    零
    「十 一 「十木 「本 列」」」」」

;; 列表之初（谓近剥蚀之末）也，从木从刀。
(: 朷 (-> (Listof Value) Value))
「 山 「朷 列」
  「中 『「卜耶 列」 卜』 『「卜耶 「本 列」」 「末 列」』 『土 「朷 「本 列」」』」」

;; 寻特定下标之元素也，从木从位省。
; Of course the sub should be natural numbers. 
; If not, you just cannot get the element, except when you are Harry Porter.
; If so, please use 9.75 for the parameter.
(: 柆 (-> (Listof Value) Numeric Value ))
「 山 「柆 列 子」 
  「中 
    『「卜耶 列」 卜』
    『「零耶 子」 「末 列」』 
    『「十小耶 子 零」 卜』
    『土 「柆 「本 列」 「十退 子」」 』 」 」
